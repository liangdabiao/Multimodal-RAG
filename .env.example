# Embedding provider: "cohere" or "dashscope"
EMBED_PROVIDER=dashscope

# Cohere (https://cohere.com)
COHERE_API_KEY=your-cohere-api-key-here

# DashScope / Qwen (https://dashscope.console.aliyun.com)
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# LLM provider: "openrouter" or "dashscope"
LLM_PROVIDER=dashscope

# OpenRouter (https://openrouter.ai) — used when LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key-here

# DashScope vision model — used when LLM_PROVIDER=dashscope
# Options: qwen3.5-flash, qwen3.5-plus, qwen3-vl-plus, qwen-vl-max
DASHSCOPE_VL_MODEL=qwen3.5-flash

# Zilliz / Milvus  （https://cloud.zilliz.com.cn/）
MILVUS_HOST=https://your-cluster.serverless.ali-cn-hangzhou.cloud.zilliz.com.cn
MILVUS_TOKEN=your-milvus-token
COHERE_COLLECTION_NAME=pdf_rag_cohere
DASHSCOPE_COLLECTION_NAME=pdf_rag_dashscope
INDEX=IVF_FLAT
